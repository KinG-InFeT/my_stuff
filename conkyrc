-- Conkyrc By Luongo Vincenzo - https://luongovincenzo.it
-- Install as ~/.conkyrc. Conky 1.10+ (Lua) syntax.
-- Names tied to this machine: Ethernet enxd0c0bf31fbb0, WiFi wlp0s20f3, VPN surfshark_wg,
-- disk nvme0n1, battery BAT0, sensors coretemp / nvme / dell_smm.

conky.config = {
    xftalpha = 0.8,
    update_interval = 3.0,
    total_run_times = 0,
    own_window = true,
    own_window_type = 'normal',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_colour = '000000',
    own_window_argb_value = 100,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    double_buffer = true,
    minimum_width = 220,
    minimum_height = 5,
    maximum_width = 450,
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = true,
    default_color = 'white',
    default_shade_color = 'black',
    alignment = 'top_right',
    gap_x = 10,
    gap_y = 50,
    no_buffers = true,
    cpu_avg_samples = 8,
    override_utf8_locale = false,
    uppercase = true,
};

conky.text = [[
${color white}${alignc}${execi 3600 lsb_release -si}$color
${color white}${alignc}$sysname $kernel ($machine)

OS: $alignr${execi 3600 lsb_release -ds}
Hostname: $alignr$nodename
Kernel: $alignr$kernel
Local IP: ${alignr}${addr enxd0c0bf31fbb0}
Remote IP: ${alignr}${execi 300 curl -s https://ipinfo.io/ip}

${color white}Monitor System $stippled_hr${color}

${color #ffffff}CPU :${alignr}${execi 3600 grep -m1 'model name' /proc/cpuinfo | cut -d: -f2}$color

Core 1: ${cpu cpu1}% ${cpubar cpu1}
Core 2: ${cpu cpu2}% ${cpubar cpu2}
Core 3: ${cpu cpu3}% ${cpubar cpu3}
Core 4: ${cpu cpu4}% ${cpubar cpu4}

Core 5: ${cpu cpu5}% ${cpubar cpu5}
Core 6: ${cpu cpu6}% ${cpubar cpu6}
Core 7: ${cpu cpu7}% ${cpubar cpu7}
Core 8: ${cpu cpu8}% ${cpubar cpu8}

${color white}RAM : ${color grey}$mem / $memmax
$memperc% ${color light grey}${membar 6}

${color white}Swap : ${color grey}$swap / $swapmax
$swapperc% ${color light grey}${swapbar 6}

${color white}Hard Drive $stippled_hr${color}

${color white}ROOT: $alignr Free: ${fs_free /} / ${fs_size /}$color
${color light grey}${fs_bar 3 /}
$color
${color white}Process Monitor System $stippled_hr${color}

${color white}Processes${alignr} CPU   Mem${color}${color light grey}
 ${color #ddaa00}${top name 1} $alignr ${top pid 1} ${top cpu 1} ${top mem 1}$color
 ${top name 2} $alignr ${top pid 2} ${top cpu 2} ${top mem 2}
 ${top name 3} $alignr ${top pid 3} ${top cpu 3} ${top mem 3}
 ${top name 4} $alignr ${top pid 4} ${top cpu 4} ${top mem 4}
 ${top name 5} $alignr ${top pid 5} ${top cpu 5} ${top mem 5}
 ${top name 6} $alignr ${top pid 6} ${top cpu 6} ${top mem 6}
 ${top name 7} $alignr ${top pid 7} ${top cpu 7} ${top mem 7}
 ${top name 8} $alignr ${top pid 8} ${top cpu 8} ${top mem 8}

Mem usage$color$stippled_hr
 ${color #ddaa00}${top_mem name 1} $alignr ${top_mem pid 1} ${top_mem cpu 1} ${top_mem mem 1}$color
 ${top_mem name 2} $alignr ${top_mem pid 2} ${top_mem cpu 2} ${top_mem mem 2}
 ${top_mem name 3} $alignr ${top_mem pid 3} ${top_mem cpu 3} ${top_mem mem 3}
 ${top_mem name 4} $alignr ${top_mem pid 4} ${top_mem cpu 4} ${top_mem mem 4}
 ${top_mem name 5} $alignr ${top_mem pid 5} ${top_mem cpu 5} ${top_mem mem 5}
 ${top_mem name 6} $alignr ${top_mem pid 6} ${top_mem cpu 6} ${top_mem mem 6}
 ${top_mem name 7} $alignr ${top_mem pid 7} ${top_mem cpu 7} ${top_mem mem 7}
 ${top_mem name 8} $alignr ${top_mem pid 8} ${top_mem cpu 8} ${top_mem mem 8}

${color white}System Info $stippled_hr${color}

Uptime: $alignr $uptime
Load Average: $alignr $loadavg
Battery: $alignr ${battery BAT0}
${battery_bar 6 BAT0}

${color white}Temperature $stippled_hr${color}

CPU Package: $alignr ${hwmon coretemp temp 1}°C
CPU Core 0: $alignr ${hwmon coretemp temp 2}°C
CPU Core 1: $alignr ${hwmon coretemp temp 3}°C
CPU Core 2: $alignr ${hwmon coretemp temp 4}°C
CPU Core 3: $alignr ${hwmon coretemp temp 5}°C
NVMe: $alignr ${hwmon nvme temp 1}°C
Fan: $alignr ${hwmon dell_smm fan 1} RPM

${color white}CPU Frequency $stippled_hr${color}

Core 1-4: ${freq_g 1}GHz ${freq_g 2}GHz ${freq_g 3}GHz ${freq_g 4}GHz
Core 5-8: ${freq_g 5}GHz ${freq_g 6}GHz ${freq_g 7}GHz ${freq_g 8}GHz

${color white}Disk I/O $stippled_hr${color}

NVMe Read: $alignr ${diskio_read nvme0n1}/s
NVMe Write: $alignr ${diskio_write nvme0n1}/s

${color white}Network $stippled_hr${color}

${if_up enxd0c0bf31fbb0}ETH Down: ${downspeed enxd0c0bf31fbb0}/s $alignr Up: ${upspeed enxd0c0bf31fbb0}/s
${endif}${if_up surfshark_wg}VPN Down: ${downspeed surfshark_wg}/s $alignr Up: ${upspeed surfshark_wg}/s
${endif}${if_up wlp0s20f3}
${color white}WiFi $stippled_hr${color}

SSID: $alignr ${wireless_essid wlp0s20f3}
Signal: ${wireless_link_qual_perc wlp0s20f3}% $alignr ${wireless_bitrate wlp0s20f3}
IP: $alignr ${addr wlp0s20f3}
${endif}]];
