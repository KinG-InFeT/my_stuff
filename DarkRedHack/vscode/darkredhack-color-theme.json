// DarkRedHack for VS Code: install.sh fills in the @drh_* colors from palette.css.
// @drh_name/AA is that color with the hex alpha AA (VS Code writes transparent colors as #rrggbbaa).
{
    "name": "DarkRedHack",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "@drh_fg",
        "descriptionForeground": "@drh_muted",
        "errorForeground": "@drh_red",
        "focusBorder": "@drh_red/99",
        "contrastBorder": "@drh_line",
        "widget.border": "@drh_line_strong",
        "widget.shadow": "#00000000",
        "selection.background": "@drh_red_fill/66",
        "icon.foreground": "@drh_muted",
        "textLink.foreground": "@drh_red",
        "textLink.activeForeground": "@drh_bright_red",
        "sash.hoverBorder": "@drh_red",
        "window.activeBorder": "@drh_red/73",
        "window.inactiveBorder": "@drh_line_strong",

        "titleBar.activeBackground": "@drh_bg",
        "titleBar.activeForeground": "@drh_fg",
        "titleBar.inactiveBackground": "@drh_bg",
        "titleBar.inactiveForeground": "@drh_muted",
        "titleBar.border": "@drh_red/73",
        "menubar.selectionBackground": "@drh_red/1f",
        "menu.background": "@drh_raised",
        "menu.foreground": "@drh_fg",
        "menu.border": "@drh_line_strong",
        "menu.selectionBackground": "@drh_red/3d",
        "menu.selectionForeground": "@drh_fg",
        "menu.separatorBackground": "@drh_line_strong",

        "activityBar.background": "@drh_bg",
        "activityBar.foreground": "@drh_fg",
        "activityBar.inactiveForeground": "@drh_muted",
        "activityBar.border": "@drh_line",
        "activityBar.activeBorder": "@drh_red",
        "activityBarBadge.background": "@drh_red_fill",
        "activityBarBadge.foreground": "#ffffff",
        "badge.background": "@drh_red_fill",
        "badge.foreground": "#ffffff",
        "progressBar.background": "@drh_red",

        "sideBar.background": "@drh_bg",
        "sideBar.foreground": "@drh_fg",
        "sideBar.border": "@drh_line",
        "sideBarTitle.foreground": "@drh_red",
        "sideBarSectionHeader.background": "@drh_bg",
        "sideBarSectionHeader.foreground": "@drh_muted",
        "sideBarSectionHeader.border": "@drh_line",
        "list.activeSelectionBackground": "@drh_red/3d",
        "list.activeSelectionForeground": "@drh_fg",
        "list.inactiveSelectionBackground": "@drh_raised",
        "list.hoverBackground": "@drh_red/1f",
        "list.focusOutline": "@drh_red",
        "list.highlightForeground": "@drh_red",
        "tree.indentGuidesStroke": "@drh_line_strong",

        "editorGroupHeader.tabsBackground": "@drh_bg",
        "editorGroupHeader.tabsBorder": "@drh_line",
        "editorGroupHeader.noTabsBackground": "@drh_bg",
        "editorGroup.border": "@drh_line",
        "tab.activeBackground": "@drh_bg",
        "tab.activeForeground": "@drh_fg",
        "tab.activeBorderTop": "@drh_red",
        "tab.inactiveBackground": "@drh_bg",
        "tab.inactiveForeground": "@drh_muted",
        "tab.hoverBackground": "@drh_surface",
        "tab.border": "@drh_line",
        "breadcrumb.foreground": "@drh_muted",
        "breadcrumb.focusForeground": "@drh_fg",
        "breadcrumb.activeSelectionForeground": "@drh_red",

        "editor.background": "@drh_bg",
        "editor.foreground": "@drh_fg",
        "editorCursor.foreground": "@drh_red",
        "editorLineNumber.foreground": "@drh_bright_black",
        "editorLineNumber.activeForeground": "@drh_red",
        "editor.lineHighlightBackground": "@drh_surface",
        "editor.lineHighlightBorder": "@drh_surface",
        "editor.selectionBackground": "@drh_red_fill/55",
        "editor.inactiveSelectionBackground": "@drh_red_fill/2e",
        "editor.selectionHighlightBackground": "@drh_red/26",
        "editor.wordHighlightBackground": "@drh_white/1f",
        "editor.wordHighlightStrongBackground": "@drh_white/2e",
        "editor.findMatchBackground": "@drh_amber/59",
        "editor.findMatchHighlightBackground": "@drh_amber/26",
        "editorBracketMatch.background": "@drh_red/1a",
        "editorBracketMatch.border": "@drh_red",
        "editorIndentGuide.background1": "@drh_line",
        "editorIndentGuide.activeBackground1": "@drh_line_strong",
        "editorWhitespace.foreground": "@drh_line_strong",
        "editorRuler.foreground": "@drh_line",
        "editorGutter.background": "@drh_bg",
        "editorGutter.addedBackground": "@drh_green",
        "editorGutter.modifiedBackground": "@drh_amber",
        "editorGutter.deletedBackground": "@drh_red",
        "editorError.foreground": "@drh_red",
        "editorWarning.foreground": "@drh_amber",
        "editorInfo.foreground": "@drh_blue",
        "editorOverviewRuler.border": "@drh_line",
        "editorWidget.background": "@drh_surface",
        "editorWidget.border": "@drh_line_strong",
        "editorHoverWidget.background": "@drh_surface",
        "editorHoverWidget.border": "@drh_line_strong",
        "editorSuggestWidget.background": "@drh_surface",
        "editorSuggestWidget.border": "@drh_line_strong",
        "editorSuggestWidget.selectedBackground": "@drh_red/3d",
        "editorSuggestWidget.highlightForeground": "@drh_red",
        "peekView.border": "@drh_red",
        "peekViewTitle.background": "@drh_raised",
        "peekViewEditor.background": "@drh_surface",
        "peekViewResult.background": "@drh_bg",
        "diffEditor.insertedTextBackground": "@drh_green/1f",
        "diffEditor.removedTextBackground": "@drh_red/1f",
        "minimap.background": "@drh_bg",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "@drh_line_strong/99",
        "scrollbarSlider.hoverBackground": "@drh_red/66",
        "scrollbarSlider.activeBackground": "@drh_red",

        "panel.background": "@drh_bg",
        "panel.border": "@drh_red/73",
        "panelTitle.activeForeground": "@drh_fg",
        "panelTitle.activeBorder": "@drh_red",
        "panelTitle.inactiveForeground": "@drh_muted",
        "statusBar.background": "@drh_bg",
        "statusBar.foreground": "@drh_muted",
        "statusBar.border": "@drh_red/73",
        "statusBar.noFolderBackground": "@drh_bg",
        "statusBar.debuggingBackground": "@drh_red_fill",
        "statusBar.debuggingForeground": "#ffffff",
        "statusBarItem.hoverBackground": "@drh_red/1f",
        "statusBarItem.remoteBackground": "@drh_red_fill",
        "statusBarItem.remoteForeground": "#ffffff",

        "button.background": "@drh_bg",
        "button.foreground": "@drh_red",
        "button.border": "@drh_red",
        "button.hoverBackground": "@drh_red/26",
        "button.secondaryBackground": "@drh_bg",
        "button.secondaryForeground": "@drh_fg",
        "button.secondaryHoverBackground": "@drh_surface",
        "input.background": "@drh_bg",
        "input.foreground": "@drh_fg",
        "input.border": "@drh_line_strong",
        "input.placeholderForeground": "@drh_bright_black",
        "inputOption.activeBorder": "@drh_red",
        "dropdown.background": "@drh_bg",
        "dropdown.foreground": "@drh_fg",
        "dropdown.border": "@drh_line_strong",
        "checkbox.background": "@drh_bg",
        "checkbox.border": "@drh_line_strong",
        "quickInput.background": "@drh_surface",
        "quickInputList.focusBackground": "@drh_red/3d",
        "pickerGroup.foreground": "@drh_red",
        "pickerGroup.border": "@drh_line_strong",
        "notifications.background": "@drh_surface",
        "notifications.border": "@drh_line_strong",
        "notificationCenterHeader.background": "@drh_raised",
        "notificationToast.border": "@drh_red",

        "gitDecoration.modifiedResourceForeground": "@drh_amber",
        "gitDecoration.untrackedResourceForeground": "@drh_green",
        "gitDecoration.addedResourceForeground": "@drh_green",
        "gitDecoration.deletedResourceForeground": "@drh_red",
        "gitDecoration.conflictingResourceForeground": "@drh_magenta",
        "gitDecoration.ignoredResourceForeground": "@drh_bright_black",

        "terminal.background": "@drh_bg",
        "terminal.foreground": "@drh_fg",
        "terminalCursor.foreground": "@drh_red",
        "terminal.selectionBackground": "@drh_red_fill/66",
        "terminal.ansiBlack": "@drh_raised",
        "terminal.ansiRed": "@drh_red",
        "terminal.ansiGreen": "@drh_green",
        "terminal.ansiYellow": "@drh_amber",
        "terminal.ansiBlue": "@drh_blue",
        "terminal.ansiMagenta": "@drh_magenta",
        "terminal.ansiCyan": "@drh_cyan",
        "terminal.ansiWhite": "@drh_white",
        "terminal.ansiBrightBlack": "@drh_bright_black",
        "terminal.ansiBrightRed": "@drh_bright_red",
        "terminal.ansiBrightGreen": "@drh_bright_green",
        "terminal.ansiBrightYellow": "@drh_bright_yellow",
        "terminal.ansiBrightBlue": "@drh_bright_blue",
        "terminal.ansiBrightMagenta": "@drh_bright_magenta",
        "terminal.ansiBrightCyan": "@drh_bright_cyan",
        "terminal.ansiBrightWhite": "@drh_fg"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "@drh_muted", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "@drh_red" } },
        { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "@drh_white" } },
        { "scope": ["string", "string.quoted", "markup.inline.raw"], "settings": { "foreground": "@drh_green" } },
        { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "@drh_magenta" } },
        { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "@drh_amber" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "@drh_blue" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "@drh_cyan" } },
        { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "@drh_fg" } },
        { "scope": ["variable.parameter", "variable.other.property", "support.variable.property"], "settings": { "foreground": "@drh_bright_cyan" } },
        { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "@drh_bright_red" } },
        { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "@drh_red" } },
        { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "@drh_amber" } },
        { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "@drh_red", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "@drh_blue" } },
        { "scope": ["markup.inserted"], "settings": { "foreground": "@drh_green" } },
        { "scope": ["markup.deleted"], "settings": { "foreground": "@drh_red" } },
        { "scope": ["markup.changed"], "settings": { "foreground": "@drh_amber" } },
        { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "@drh_bright_red", "fontStyle": "underline" } }
    ]
}
